{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "db:init": "prisma db init --config prisma.config.js",
    "db:update": "prisma db update --config prisma.config.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "contract:emit": "prisma contract emit --config prisma.config.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.18",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prisma/cli-engine": "0.7.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prisma": "8.0.0-rc.23"
  }
}
